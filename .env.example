# URL publique du site (sans slash final).
# Utilisée pour metadataBase, les URLs canoniques et le sitemap.
# En l'absence de valeur, le domaine de production est utilisé.
NEXT_PUBLIC_SITE_URL=https://zakariaaskri.vercel.app

# Indexation :
# - non défini : activée uniquement sur Vercel en production, désactivée en preview et en local
# - "true"    : toujours activée
# - "false"   : toujours désactivée (noindex + robots Disallow)
# NEXT_PUBLIC_ALLOW_INDEX=true

# Vérification Google Search Console (balise meta), si utilisée.
# GOOGLE_SITE_VERIFICATION=
