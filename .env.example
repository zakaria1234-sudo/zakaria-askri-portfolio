# URL publique du site (sans slash final).
# Utilisée pour metadataBase, les URLs canoniques et le sitemap.
NEXT_PUBLIC_SITE_URL=https://zakaria-askri.vercel.app

# Passer à "true" uniquement au moment de la mise en production publique.
# Tant que la valeur est "false", le site est en noindex.
NEXT_PUBLIC_ALLOW_INDEX=false
